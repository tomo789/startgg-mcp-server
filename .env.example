# start.gg API token (required).
# Create one at https://start.gg/admin/profile/developer
STARTGG_TOKEN=

# Enable write (mutation) tools. The current version implements no mutations;
# this flag is reserved and keeping it false is recommended.
STARTGG_ENABLE_WRITES=false

# --- Optional tuning ---

# Requests per 60-second window (start.gg allows 80; default is 75 for headroom).
# STARTGG_RATE_LIMIT=75

# HTTP request timeout in milliseconds (default 30000).
# STARTGG_TIMEOUT_MS=30000

# Set to "off" to disable the in-memory response cache.
# STARTGG_CACHE=on
